    },
    {
      "created_at": "2026-10-09T17:23:18Z",
      "id": "01M4GV1M2A3K38T73JCVCD9G0R",
      "impact": "minor",
      "incident_updates": [
        {
          "body": "We have implemented a mitigation, and delayed Costs data is now processing through the Compliance API. Some customers may continue to see incomplete Costs data while the backlog catches up. We expect this catch-up process to continue through Sunday, October 11. ChatGPT usage and API Platform requests remain unaffected. We are monitoring recovery.",
          "created_at": "2026-10-09T22:03:59Z",
          "display_at": "2026-10-09T22:03:59Z",
          "id": "01M4HB3JQR38KYXS3RSAZBT2FC",
          "incident_id": "01M4GV1M2A3K38T73JCVCD9G0R",
          "status": "monitoring",
          "updated_at": "2026-10-09T22:03:59Z"
        },
        {
          "body": "Some customers may continue to experience delayed Costs data through the Compliance API. ChatGPT usage and API Platform requests are not affected, and other reporting channels remain available. We have identified the cause and are continuing work to restore normal data freshness. We will provide another update as work progresses.",
          "created_at": "2026-10-09T18:46:25Z",
          "display_at": "2026-10-09T18:46:25Z",
          "id": "01M4GZSTQD80N1F9QNVV9MCPFN",
          "incident_id": "01M4GV1M2A3K38T73JCVCD9G0R",
          "status": "identified",
          "updated_at": "2026-10-09T18:46:25Z"
        },
        {
          "body": "We have identified an issue causing delays in publishing Costs data through the Compliance API. The API Platform organization costs endpoint and ChatGPT usage are not affected, and other reporting channels remain available. We are working to restore normal data freshness.",
          "created_at": "2026-10-09T17:27:49Z",
          "display_at": "2026-10-09T17:27:49Z",
          "id": "01M4GV9WN6CQJ085324GXRTZTB",
          "incident_id": "01M4GV1M2A3K38T73JCVCD9G0R",
          "status": "identified",
          "updated_at": "2026-10-09T17:27:49Z"
        },
        {
          "body": "We have identified an issue causing delays in publishing organization cost data through the Costs API. API and ChatGPT usage are not affected, and other reporting channels remain available. We are working to restore normal data freshness.",
          "created_at": "2026-10-09T17:23:18Z",
